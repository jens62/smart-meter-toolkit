# Config for send_results_from_DB_as_html_mail_daily_with_bar_3dec.py.
#
# Copy this file to e.g. ~/.config/three-phase-meter-mail.env, fill in the
# values, then: chmod 600 ~/.config/three-phase-meter-mail.env
#
# cron does not source your shell profile, so the job in crontab.example
# sources this file itself before running the script.

# --- Database (see ../../persistence/mysql/) ---
export METER_DB_HOST='localhost'
export METER_DB_USER='...'
export METER_DB_PASSWORD='...'
export METER_DB_NAME='...'
# Must match the device id used in persistence/mysql/schema.sql and the
# telegraf configs under ../../acquisition/tasmota-ir/ and ../../persistence/mysql/.
export METER_DEVICE_ID='...'

# --- Email ---
export MAIL_SENDER_NAME='...'
export MAIL_SENDER_EMAIL='...'
export MAIL_REPLY_TO_NAME='...'
export MAIL_REPLY_TO_EMAIL='...'
export MAIL_RECIPIENT='...'
# Optional - leave empty/unset to omit Cc entirely.
export MAIL_CC_RECIPIENT='...'

# --- Publishing (report gets written locally, then copied to a public webserver) ---
# No trailing slash - the script appends /data/daily-email_<date>.html and /index.php.
export REPORT_PUBLIC_BASE_URL='https://example.org/three-phase-meter'
export REPORT_LOCAL_PUBLISH_DIR='/path/to/local/publish-directory'
# SSH host alias (see ~/.ssh/config) the report gets scp'd to.
export REPORT_REMOTE_SSH_HOST='...'
export REPORT_REMOTE_PUBLISH_DIR='/path/to/remote/publish-directory'

# --- Optional ---
# Leave unset to omit the Grafana link from the report entirely.
export REPORT_GRAFANA_URL='http://192.168.1.100:3000/d/...'
export REPORT_METER_DESCRIPTION='Stromzähler'
# Leave unset to omit the ", über <reading head>" clause from the heading entirely.
export REPORT_READING_HEAD_DESCRIPTION='...'
